{
  "manifest_version": 3,
  "name": "Enviador SRI — Gestor Tributario",
  "description": "Lleva al portal del SRI lo armado en el Gestor Tributario: presenta la devolución de IVA y deja cargadas las declaraciones (IVA, ICE, 103) y los anexos ICE/PVP para revisarlos.",
  "version": "1.1.0",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://tributos.pensamiento-libre.org/*",
        "http://localhost:5173/*"
      ],
      "js": ["contenido-app.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/devolucionTerceraEdad-internet/*"
      ],
      "js": ["contenido-sri.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/sri-declaraciones-web-internet/*",
        "https://srienlinea.sri.gob.ec/rig/*"
      ],
      "js": ["cargador-sri.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["enviador.js"],
      "matches": ["https://srienlinea.sri.gob.ec/*"]
    }
  ]
}
